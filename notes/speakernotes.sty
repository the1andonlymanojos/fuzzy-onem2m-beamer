% Shared layout for the five speaker-notes PDFs.
% Each notes file sets \speakername, \speakercolor, \partno, then uses
%   \cover{...}                      first page: cheat sheet
%   \slide{key}{time}{what is on it}  a slide thumbnail with its time and gist,
%                                     followed by the script as normal text
% Slide thumbnails come from ../deck.pdf; page numbers from ../deck.slidemap.
\ProvidesPackage{speakernotes}
\RequirePackage[a4paper,margin=1.7cm,top=1.5cm,bottom=1.6cm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{amsmath}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage[hidelinks]{hyperref}

\setmainfont{TeX Gyre Heros}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlist{itemsep=2pt,topsep=3pt,leftmargin=1.3em}

\definecolor{spRaj}{HTML}{1F5F99}
\definecolor{spManoj}{HTML}{1E7A5A}
\definecolor{spAshutosh}{HTML}{B5541B}
\definecolor{spJohn}{HTML}{6A4C9C}
\definecolor{spAyush}{HTML}{B23A5B}
\definecolor{ink}{HTML}{1A1A1A}
\definecolor{soft}{HTML}{F5F3EE}

% slide map written by deck.tex
\def\slidepage#1#2{\expandafter\gdef\csname sp@#1\endcsname{#2}}
\IfFileExists{../deck.slidemap}{\input{../deck.slidemap}}{}
\newcommand{\slidenum}[1]{\ifcsname sp@#1\endcsname\csname sp@#1\endcsname\else 1\fi}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{ink!50}Speaker notes \textbullet{} Part \partno{} \textbullet{} \speakername}
\fancyfoot[R]{\footnotesize\color{ink!50}\thepage}

\newcommand{\say}[1]{\par{\color{speaker}\bfseries Say:}\enspace #1\par}
\newcommand{\tip}[1]{\par{\small\color{ink!60}\textit{Tip:} #1}\par}
\newcommand{\ifasked}[2]{\par{\small\color{speaker}\bfseries Q:}\enspace{\small\itshape #1}\par
  \vspace{-3pt}{\small\color{ink!75}\bfseries A:}\enspace{\small #2}\par}

% A slide block: coloured header, thumbnail left, gist right, script below.
\newcommand{\slide}[3]{%
  \Needspace{14\baselineskip}%
  \vspace{8pt}%
  \begin{tikzpicture}
    \fill[speaker] (0,0) rectangle (\linewidth,0.62);
    \node[anchor=west,text=white,font=\bfseries] at (0.2,0.31) {Slide \slidenum{#1}};
    \node[anchor=east,text=white,font=\small] at (\linewidth-0.2cm,0.31) {#2};
  \end{tikzpicture}\par\vspace{2pt}%
  \begin{minipage}[t]{0.47\linewidth}\vspace{0pt}%
    \fcolorbox{ink!20}{white}{\includegraphics[page=\slidenum{#1},width=\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax]{../deck.pdf}}%
  \end{minipage}\hfill
  \begin{minipage}[t]{0.5\linewidth}\vspace{0pt}\small #3\end{minipage}\par\vspace{4pt}}

% Cover / cheat sheet
\newcommand{\cover}[1]{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[speaker] (current page.north west) rectangle ([yshift=-5.2cm]current page.north east);
    \node[anchor=north west,text=white,font=\fontsize{64}{64}\selectfont\bfseries]
      at ([xshift=1.7cm,yshift=-0.9cm]current page.north west) {\partno};
    \node[anchor=north west,text=white,font=\huge\bfseries]
      at ([xshift=5.2cm,yshift=-1.3cm]current page.north west) {\speakername};
    \node[anchor=north west,text=white,font=\large,text width=13cm]
      at ([xshift=5.2cm,yshift=-2.4cm]current page.north west) {\parttitle};
    \node[anchor=north west,text=white!85!speaker,font=\small,text width=13cm]
      at ([xshift=5.2cm,yshift=-3.75cm]current page.north west)
      {Fuzzy-Logic-Based QoS Control in oneM2M (Zyane \& Et-Tousy, FiCloud 2026)};
  \end{tikzpicture}%
  \vspace*{4.6cm}%
  #1\clearpage}

\newcommand{\cheat}[2]{% #1 title, #2 body: a tinted box on the cover
  \par\noindent\colorbox{soft}{\begin{minipage}{\dimexpr\linewidth-2\fboxsep\relax}
    {\color{speaker}\bfseries #1}\par\vspace{2pt}#2\end{minipage}}\par\vspace{4pt}}
